{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.earnerbaymalay.promptpack-marketplace",
  "productName": "PromptPack Marketplace",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PromptPack Marketplace",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' data: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https: fonts.googleapis.com;"
    }
  },
  "plugins": {
    "dialog": null,
    "fs": null,
    "shell": { "open": true },
    "store": null,
    "opener": null,
    "clipboard": null,
    "notification": null
  },
  "bundle": {
    "icon": []
  }
}