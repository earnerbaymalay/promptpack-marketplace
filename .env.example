# Application
TAURI_APP_APP__NAME="My App"
TAURI_APP_APP__VERSION="0.1.0"
TAURI_APP_APP__IDENTIFIER="com.example.myapp"
TAURI_APP_APP__GLOBAL_SHORTCUTS_ENABLED="true"
TAURI_APP_APP__AUTO_CHECK_UPDATES="true"
TAURI_APP_APP__TELEMETRY_ENABLED="false"

# Window
TAURI_APP_WINDOW__TITLE="My App"
TAURI_APP_WINDOW__WIDTH="1200"
TAURI_APP_WINDOW__HEIGHT="800"
TAURI_APP_WINDOW__MIN_WIDTH="800"
TAURI_APP_WINDOW__MIN_HEIGHT="600"
TAURI_APP_WINDOW__RESIZABLE="true"
TAURI_APP_WINDOW__FULLSCREEN="false"
TAURI_APP_WINDOW__MAXIMIZED="false"
TAURI_APP_WINDOW__VISIBLE="true"
TAURI_APP_WINDOW__TRANSPARENT="false"
TAURI_APP_WINDOW__DECORATIONS="true"
TAURI_APP_WINDOW__ALWAYS_ON_TOP="false"
TAURI_APP_WINDOW__CENTER="true"

# Security
TAURI_APP_SECURITY__CSP="default-src 'self' data: https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' https: fonts.googleapis.com;"
TAURI_APP_SECURITY__DEVTOOLS="true"

# Updater
TAURI_APP_UPDATER__ACTIVE="false"
TAURI_APP_UPDATER__DIALOG="true"
TAURI_APP_UPDATER__PUBKEY=""

# Database
TAURI_APP_DATABASE__MAX_CONNECTIONS="10"
TAURI_APP_DATABASE__ENABLE_WAL="true"

# Logging
TAURI_APP_LOGGING__LEVEL="info"
TAURI_APP_LOGGING__FORMAT="pretty"
TAURI_APP_LOGGING__FILE=""

# Ollama
OLLAMA_HOST="http://localhost:11434"
OLLAMA_DEFAULT_MODEL="qwen2.5-coder:1.5b"

# Stripe (optional)
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# GitHub (for release automation)
GH_TOKEN=""
GITHUB_TOKEN=""

# HWCert specific
HWCERT_FIRMWARE_DB_URL="https://earnerbaymalay.github.io/hwcert-firmware-db"
HWCERT_FWUPD_DAEMON="false"

# PromptPack specific
PROMPTPACK_REGISTRY_URL="https://earnerbaymalay.github.io/promptpack-index/index.json"
PROMPTPACK_STRIPE_KEY=""